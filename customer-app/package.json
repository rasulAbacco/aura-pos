{
  "name": "@aura/customer-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Salora Glam customer app: find salons, book services, order products. Web + Android/iOS (Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "setup": "node -e \"const f=require('fs');if(!f.existsSync('.env')){f.copyFileSync('.env.example','.env');console.log('Created customer-app/.env')}\"",
    "build:android": "vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "build:ios": "vite build --mode ios && cap sync ios",
    "ios:open": "cap open ios",
    "app:icons": "capacitor-assets generate --ios --android --iconBackgroundColor \"#fbf5f2\" --splashBackgroundColor \"#fbf5f2\"",
    "native:permissions": "node scripts/native-permissions.mjs",
    "app:setup": "npm run app:icons && npm run native:permissions"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "axios": "1.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
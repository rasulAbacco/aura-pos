# ── Copy to .env and fill in. Never commit real values. ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aura:aura@localhost:5432/aura_dev
# Phone apps (Capacitor): Android sends Origin https://localhost, iOS sends capacitor://localhost.
# EXTRA_CORS_ORIGINS=https://localhost,capacitor://localhost
EXTRA_CORS_ORIGINS=
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# auto (recommended): Strict when the website and API share one address, None+Secure when the website
# calls the API on another address (two *.onrender.com services). Needs COOKIE_SECURE=true in production.
COOKIE_SAMESITE=auto
# How long the phone app stays signed in without use (days, renewed every time the app is opened).
REFRESH_TOKEN_TTL_DAYS_NATIVE=365
# Database connections per server process.
DB_POOL_MAX=10
TRUST_PROXY=0
# Razorpay (test keys rzp_test_… in dev/staging; live keys only in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SIGNUP_TRIAL_PLAN_CODE=trial
RUN_JOBS=false
SERVE_CLIENT=false
# Free hosting that sleeps when idle (Render free): ping our own public health URL every N minutes. Empty = off.
# KEEP_ALIVE_URL=https://your-service.onrender.com/health
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MIN=10
LOG_LEVEL=info
EMAIL_FROM=Salora Glam <no-reply@example.com>
# smtp://user:pass@host:587 — empty = dev outbox (production refuses to start without it)
SMTP_URL=

# ── Customer app (Salora Glam): customers sign in with mobile number + SMS code ──
# Address of the customer website (allowed to call this API). The phone apps use https://localhost
# (Android) and capacitor://localhost (iOS): add those to EXTRA_CORS_ORIGINS above.
CUSTOMER_APP_ORIGIN=http://localhost:5174
# How sign-in codes are sent: console (development only — printed in this server's log),
# smsgatewayhub (SMS Gateway Hub), twofactor (2Factor.in), msg91 (India; needs a DLT-approved OTP template whose variable is ##OTP##) or twilio.
SMS_PROVIDER=console
# SMS Gateway Hub (set SMS_PROVIDER=smsgatewayhub). Values from the SMS Gateway Hub panel and your DLT registration.
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ROUTE=
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=
# The OTP text exactly as approved on DLT for SMS_TEMPLATE_ID; {otp} is replaced by the code (valid 10 minutes).
SMS_TEMPLATE_TEXT="{otp} is your OTP for Abacco Technology CRM login verification. OTP valid for 10 minutes. Do not share this OTP with anyone."
# 2Factor.in: API key from the 2Factor dashboard. TWOFACTOR_TEMPLATE = name of your approved OTP
# template in 2Factor (leave empty to use 2Factor's default OTP message).
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Development only: the code is also shown in the app, so you can try it without SMS. Ignored in production.
OTP_DEV_ECHO=true
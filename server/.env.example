# ── Copy to .env and fill in. Never commit real values. ──
NODE_ENV=development
PORT=4000
# DATABASE_URL=postgresql://aura:aura@localhost:5432/aura_dev
DATABASE_URL="postgresql://abaccotechnology:root@localhost:5432/aura_dev?schema=public"
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=0
# Razorpay (test keys rzp_test_… in dev/staging; live keys only in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SIGNUP_TRIAL_PLAN_CODE=trial
RUN_JOBS=false
SERVE_CLIENT=false
LOG_LEVEL=info
EMAIL_FROM=Aura POS <no-reply@example.com>
# smtp://user:pass@host:587 — empty = dev outbox (production refuses to start without it)
SMTP_URL=
